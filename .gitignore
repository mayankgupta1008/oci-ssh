# Terraform

# Local .terraform directories
**/.terraform/*

# Generated at deploy time — points to S3 backend, not committed
infra/cloud-deploy/terraform/backend.tf

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets.
*.tfvars
*.tfvars.json

# Secrets Manager populate file (Option B) — real values, never commit
secrets.json

# Terraform plan output files (can contain sensitive data)
*tfplan*

# Ignore override files as they are usually used to override resources locally and not committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes Config
.kube/
kubeconfig_*
k3s.yaml

# ───────── Next.js / Vercel (merged from app/.gitignore) ─────────
/.pnp
.pnp.*
.next/
/out/
/build
.vercel
next-env.d.ts
# NOTE: env files already handled above (.env, .env.* ignored; !.env.example kept).
# Do NOT add a bare `.env*` here — it would re-ignore .env.example.

.serena
.oci/
.dual-graph/

# Python bytecode (was tracked under .agent/)
__pycache__/
*.pyc
.playwright-mcp
.megamemory
.openclaude/