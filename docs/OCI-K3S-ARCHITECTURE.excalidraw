      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "No inbound ports: 80/443/6443 closed.\nNo MetalLB / ServiceLB / OCI LB: cloudflared dials out,\nTraefik stays ClusterIP.",
      "roughness": 1,
      "roundness": null,
      "seed": 389371374,
      "strokeColor": "#e03131",
      "strokeStyle": "solid",
      "strokeWidth": 2,
