      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "DNS: proxied CNAMEs @ and * → <tunnel-id>.cfargotunnel.com\nNew app = one Ingress with gethomepage.dev annotations → new card.\nNo DNS, tunnel, or load balancer change per app.",
      "roughness": 1,
      "roundness": null,
      "seed": 1125777499,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "DNS: proxied CNAMEs @ and * → <tunnel-id>.cfargotunnel.com\nNew app = one Ingress with gethomepage.dev annotations → new card.\nNo DNS, tunnel, or load balancer change per app.",
      "textAlign": "left",
      "updated": 1792573016114,
      "version": 1,
      "versionNonce": 1703289135,
      "verticalAlign": "top"
    },
    {
      "id": "b9",
      "type": "text",
      "x": 600,
